# Copy to .env.local and fill in. Never commit .env.local.

# --- Booking notification email (SMTP) ---
# The website emails every booking / quote request here.
BOOKINGS_TO=apexcardetailing.info@gmail.com

# Gmail: create an App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=apexcardetailing.info@gmail.com
SMTP_PASS=your-16-char-app-password
# Optional: overrides the From header (defaults to SMTP_USER).
SMTP_FROM="Apex Mobile Car Detailing Website <apexcardetailing.info@gmail.com>"
